RewriteEngine on

# []: définir un bloc de pattern
# {}: définir le nombre exact de caractère
# +: au moins 1 fois
# *: 0 ou plusieurs (optionnel)
# \: permet de ne pas interprétéer le carcactère qui suit
# (): définir une valeur récupérable dans l'URL
# $x: pour récuperer la valeur entre ()

# --------------------------------------------
# Fichiers ou dossiers réels (css, js, images, pdf, zip, etc.) : pas de réécriture, on les sert tels quels
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --------------------------------------------
# RÈGLES DE RÉ-ÉCRITURE

# --------------------------------------------
# PAGINATION DE L'ACCUEIL
# PATTERN: /page/x.html
# URL: ?page=x

RewriteRule ^page/([1-9][0-9]*)\.html$ ?page=$1 [L]

# ROUTE PROJET.SHOW
# PATTERN: /projets/id/slug.html
# URL: ?projets=show&id=x

RewriteRule ^projets\/([1-9][0-9]*)\/[a-z0-9]([a-z0-9\-]*[a-z0-9])*\.html$ ?projets=show&id=$1 [L]

# --------------------------------------------

# formulaire d'ajout d'un projet
# PATTERN: /projets/add/form.html
#URL : ?projets/add/form

RewriteRule ^projets/add/form\.html$ ?projets=addForm [L]

# --------------------------------------------

# Ajout d'un projet
# PATTERN: /projets/add/insert.html
#URL : ?projets/add/insert

RewriteRule ^projets/add/insert\.html$ ?projets=addInsert [L]

# --------------------------------------------
# ROUTE SUPPRESSION D'UN PROJET
# PATTERN: /projets/delete/id/slug.html
# URL: ?projets=delete&id=x

RewriteRule ^projets/delete\/([1-9][0-9]*)\/([a-z0-9\-]*[a-z0-9])*\.html$ ?projets=delete&id=$1 [L]

# --------------------------------------------


# formulaire de modification d'un projet
# PATTERN: /projets/id/slug/edit/form.html
# URL: ?projets=editForm&id=x

RewriteRule ^projets\/([1-9][0-9]*)\/([a-z0-9\-]*[a-z0-9])*\/edit/form\.html$ ?projets=editForm&id=$1 [L]

# formulaire de modification d'un projet
# PATTERN: /projets/id/slug/edit/update.html
# URL: ?projets=editUpdate&id=x

RewriteRule ^projets\/([1-9][0-9]*)\/([a-z0-9\-]*[a-z0-9])*\/edit/update\.html$ ?projets=editUpdate&id=$1 [L]